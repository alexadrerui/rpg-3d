# ─── Database ────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/rpg3d"

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Object Storage (S3-compatible) ─────────────────────────
# Para MinIO local: STORAGE_ENDPOINT="http://localhost:9000", STORAGE_REGION="us-east-1"
# Para Cloudflare R2: STORAGE_ENDPOINT="https://<account>.r2.cloudflarestorage.com", STORAGE_REGION="auto"
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="rpg3d-assets"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_PUBLIC_URL="https://cdn.rpg3d.app"

# ─── Servers ─────────────────────────────────────────────────
API_SERVER_PORT=4000
GAME_SERVER_PORT=4001

# ─── Apps (Vite / Next public vars) ─────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000"
VITE_API_URL="http://localhost:4000"
VITE_GAME_SERVER_URL="http://localhost:4001"

# ─── App URLs (usados pelos apps para gerar links) ────
DASHBOARD_URL="http://localhost:3003"
VITE_EDITOR_URL="http://localhost:3001"
VITE_GAME_URL="http://localhost:3002"

# ─── Server-to-server secret ─────────────────────────
SERVER_SECRET="dev-server-secret"
