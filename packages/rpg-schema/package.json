{
  "name": "@rpg3d/schema",
  "version": "0.1.0",
  "description": "Contrato central do RPG 3D — schemas Zod para cenas, triggers e eventos WebSocket",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "typescript": "6.0.2",
    "zod": "^4.3.5"
  },
  "license": "MIT"
}
