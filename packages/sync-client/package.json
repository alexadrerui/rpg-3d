{
  "name": "@rpg3d/sync-client",
  "version": "0.1.0",
  "description": "Hook useGameRoom — Socket.io client para sessões ao vivo de RPG",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@rpg3d/schema": "*",
    "socket.io-client": "^4.8.1",
    "zustand": "^5.0.3",
    "react": "^19.2.4"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "typescript": "6.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "license": "MIT"
}
