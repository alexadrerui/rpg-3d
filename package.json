{
  "name": "rpg-3d",
  "private": true,
  "scripts": {
    "dev":            "turbo run dev",
    "dev:editor":     "turbo run dev --filter=@rpg3d/app-editor",
    "dev:game":       "turbo run dev --filter=@rpg3d/app-game",
    "dev:dashboard":  "turbo run dev --filter=@rpg3d/app-dashboard",
    "dev:game-server":"turbo run dev --filter=@rpg3d/game-server",
    "dev:api-server": "turbo run dev --filter=@rpg3d/api-server",
    "dev:servers":    "turbo run dev --filter=@rpg3d/game-server --filter=@rpg3d/api-server",
    "build":          "turbo run build",
    "check-types":    "turbo run check-types",
    "lint":           "biome lint",
    "format":         "biome format --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "dotenv-cli":     "^11.0.0",
    "turbo":          "^2.8.15",
    "typescript":     "6.0.2"
  },
  "engines": { "node": ">=18" },
  "packageManager": "bun@1.3.0",
  "overrides": {
    "@types/react":     "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three":     "0.184.0"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.0",
    "lightningcss-linux-x64-gnu":       "1.32.0"
  },
  "workspaces": [
    "apps/editor",
    "apps/game",
    "apps/dashboard",
    "packages/*",
    "tooling/*",
    "server/*"
  ]
}
