generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  name                String
  password            String
  credits             Int      @default(1000)
  registrationIpHash  String?  // HMAC-SHA256 do IP de cadastro — LGPD art.12 (dado anonimizado)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ownedCampaigns  Campaign[]           @relation("CampaignMaster")
  characters      Character[]
  invites         CampaignInvite[]
  uploadedAssets  Asset[]
  systemPurchases UserSystemPurchase[]
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  description String?
  masterId    String
  systemId    String   // "dnd5e" | "pathfinder" | "custom"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  master     User             @relation("CampaignMaster", fields: [masterId], references: [id])
  scenes     Scene[]
  characters Character[]
  invites    CampaignInvite[]
  sessions   Session[]
  assets     Asset[]
  logs       SessionLog[]
}

model Scene {
  id          String   @id @default(cuid())
  campaignId  String
  name        String
  description String?
  fileUrl     String   // URL do .rpgscene no object storage
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
}

model Character {
  id         String   @id @default(cuid())
  campaignId String
  userId     String
  name       String
  sheetData  Json     // dados da ficha conforme sistema
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model CampaignInvite {
  id         String    @id @default(cuid())
  campaignId String
  token      String    @unique @default(cuid())
  usedBy     String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  user     User?    @relation(fields: [usedBy], references: [id])
}

model Session {
  id         String    @id @default(cuid())
  campaignId String
  sceneId    String?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  campaign Campaign    @relation(fields: [campaignId], references: [id])
  logs     SessionLog[]
}

enum SessionEventType {
  JOIN
  LEAVE
  CHAT
  DICE
  SCENE_LOAD
  NPC_SPAWN
  NPC_DESPAWN
  NOTE_REVEAL
  TRAP_DISARM
  FOG_CLEAR
}

model SessionLog {
  id         String           @id @default(cuid())
  sessionId  String
  campaignId String
  type       SessionEventType
  actorName  String?
  data       Json?
  timestamp  DateTime         @default(now())

  session  Session  @relation(fields: [sessionId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@index([sessionId])
  @@index([campaignId])
}

model Asset {
  id          String   @id @default(cuid())
  campaignId  String
  uploadedBy  String
  fileName    String
  mimeType    String
  sizeBytes   Int?
  publicUrl   String
  storageKey  String
  confirmed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id])
  uploader User     @relation(fields: [uploadedBy], references: [id])
}

// ── Game Systems ───────────────────────────────────────────────────────────────

model GameSystemCatalog {
  id          String   @id        // "dnd5e", "generic"
  name        String
  description String
  price       Int      @default(0)         // em créditos internos (0 = gratuito)
  version     String   @default("1.0.0")
  thumbnail   String?
  tags        String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases   UserSystemPurchase[]
}

model UserSystemPurchase {
  id          String   @id @default(cuid())
  userId      String
  systemId    String
  purchasedAt DateTime @default(now())

  user   User              @relation(fields: [userId],   references: [id], onDelete: Cascade)
  system GameSystemCatalog @relation(fields: [systemId], references: [id])

  @@unique([userId, systemId])
}
