{
  "name": "@rpg3d/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":   "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "db:push":     "prisma db push",
    "db:generate": "prisma generate",
    "check-types": "tsc --noEmit",
    "test":        "vitest run",
    "test:watch":  "vitest"
  },
  "dependencies": {
    "@rpg3d/schema":                    "*",
    "@prisma/client":                   "^6.9.0",
    "@aws-sdk/client-s3":               "^3.823.0",
    "@aws-sdk/s3-request-presigner":    "^3.823.0",
    "express":                          "^4.21.2",
    "jsonwebtoken":                     "^9.0.2",
    "bcryptjs":                         "^3.0.2",
    "zod":                              "^4.3.5",
    "cors":                             "^2.8.5"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/express":       "^5.0.3",
    "@types/jsonwebtoken":  "^9.0.9",
    "@types/bcryptjs":      "^2.4.6",
    "@types/cors":          "^2.8.17",
    "@types/node":          "^22.0.0",
    "prisma":               "^6.9.0",
    "tsx":                  "^4.19.4",
    "typescript":           "6.0.2",
    "vitest":               "^2.0.0",
    "supertest":            "^7.0.0",
    "@types/supertest":     "^6.0.2"
  }
}
