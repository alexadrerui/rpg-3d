{
  "name": "@rpg3d/game-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev":         "tsx watch src/index.ts",
    "build":       "tsc --project tsconfig.json",
    "start":       "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test":        "vitest run",
    "test:watch":  "vitest"
  },
  "dependencies": {
    "@rpg3d/schema": "*",
    "@rpg3d/dice-engine": "*",
    "@rpg3d/game-systems": "*",
    "socket.io": "^4.8.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.3.5",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@pascal/typescript-config": "*",
    "@types/express":    "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node":       "^22.0.0",
    "tsx":               "^4.19.4",
    "typescript":        "6.0.2",
    "@types/cors":       "^2.8.17",
    "vitest":            "^2.0.0",
    "socket.io-client":  "^4.8.1"
  }
}